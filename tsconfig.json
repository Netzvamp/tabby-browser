{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "lib": ["dom", "es2018"],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"]
}
